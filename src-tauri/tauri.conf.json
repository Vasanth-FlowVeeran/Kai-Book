{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "KaiBook",
  "version": "0.1.0",
  "identifier": "com.kaibook.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KaiBook",
        "url": "index.html",
        "width": 680,
        "height": 720,
        "minWidth": 400,
        "minHeight": 500,
        "center": true,
        "visible": false,
        "decorations": true,
        "resizable": true
      },
      {
        "label": "tray-popup",
        "title": "KaiBook",
        "url": "tray.html",
        "width": 320,
        "height": 440,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true,
      "tooltip": "KaiBook — Contact Manager"
    },
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
