{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "KaiBook",
  "version": "1.0.1",
  "identifier": "com.kaibook.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "KaiBook",
        "url": "index.html",
        "width": 680,
        "height": 800,
        "minWidth": 400,
        "minHeight": 500,
        "center": true,
        "visible": false,
        "decorations": true,
        "resizable": true,
        "theme": "Dark"
      },
      {
        "label": "tray-popup",
        "title": "KaiBook",
        "url": "tray.html",
        "width": 320,
        "height": 440,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A versatile system tray contact book for freelancers",
    "longDescription": "KaiBook is a lightweight, beautiful contact manager that lives in your system tray. Designed for freelancers who need quick access to client contacts with features like favorites, contact groups, drag-to-reorder, multiple themes, and instant search.",
    "copyright": "Copyright 2026 Raj",
    "licenseFile": "../LICENSE",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "startMenuFolder": "KaiBook"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "opener": {}
  }
}