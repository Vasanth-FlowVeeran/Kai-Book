{
  "$schema": "https://raw.githubusercontent.com/nicokosi/tauri/dev/crates/tauri-utils/schema.json",
  "identifier": "default",
  "description": "Default capabilities for KaiBook",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
